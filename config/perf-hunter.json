{
  "_comment": "perf-hunter 统一配置文件 - 合并 risk、rules 和 thresholds",
  "_version": "1.2",

  "risk": {
    "_comment": "风险显示配置",
    "colors": {
      "critical": "\u001b[91m",
      "warning": "\u001b[93m",
      "info": "\u001b[94m",
      "reset": "\u001b[0m"
    },
    "templates": {
      "issue_open": "[OPEN] [{id}] [{level}] {desc}",
      "issue_resolved": "[RESOLVED] [{id}] [{level}] {desc}",
      "hint": "→ {hint}",
      "result": "→ {result}",
      "list_header_open": "[OPEN] {count} issues pending",
      "list_header_resolved": "[RESOLVED] {count} issues",
      "list_header_all": "[ALL] {open_count} open, {resolved_count} resolved",
      "timeline_command": "[{seq}] {time} {command}",
      "timeline_finding_created": "[{level}] {issue_id}: {desc}",
      "timeline_finding_resolved": "[RESOLVED] {issue_id}: {result}",
      "timeline_info": "[INFO] {message}"
    },
    "show": {
      "hint": true,
      "result": true
    }
  },

  "modes": {
    "_comment": "显示模式覆盖",
    "ci": {
      "colors": {
        "critical": "",
        "warning": "",
        "info": "",
        "reset": ""
      }
    },
    "compact": {
      "templates": {
        "issue_open": "[OPEN] {id} [{level}] {desc}",
        "issue_resolved": "[RESOLVED] {id} [{level}] {desc}"
      },
      "show": {
        "hint": false,
        "result": false
      }
    }
  },

  "rules": {
    "_comment": "分析规则配置",
    "expert_rules": {
      "_description": "符号分类规则 - 用于 cluster-symbols 等命令",
      "EVENT_IRQ_OFF": "irqoff|spin_unlock_irqrestore|ksoftirqd",
      "EVENT_SCHEDULER": "sched_|pick_next_task|load_balance|idle_balance|dequeue_task|enqueue_task",
      "EVENT_MEM_RECLAIM": "direct_reclaim|try_to_free_pages|tlb_flush|tlb_shootdown",
      "EVENT_LOCK_CONTENTION": "spin_lock|mutex_lock|rwsem_down|queued_spin_lock",
      "EVENT_SYNC_PRIMITIVE": "pthread_mutex|pthread_cond|pthread_sig|futex_wait|futex_wake"
    },
    "idle_detection": {
      "_comment": "Idle 进程检测规则",
      "enabled": true,
      "pid_zero": true
    },
    "sensitive_comms": {
      "_comment": "敏感进程分类 - 用于检测特定系统事件",
      "categories": [
        {
          "name": "NETWORK_TC",
          "comms": ["tc", "tc-ng"],
          "message": "流量控制(TC)活动 - 可能影响网络延迟",
          "flag": "<X1>"
        },
        {
          "name": "FIREWALL",
          "comms": ["iptables", "ipset", "nft", "ebtables", "arptables"],
          "message": "防火墙规则变更 - 可能影响网络吞吐",
          "flag": "<X1>"
        },
        {
          "name": "BPF",
          "comms": ["bpftool", "bpfload"],
          "message": "BPF程序加载 - 可能影响系统调用性能",
          "flag": "<X1>"
        }
      ]
    }
  },

  "display_threshold": {
    "_comment": "显示过滤阈值 - 用于TopN列表和专家锚点",
    "_description": "只有 total_cpu > display_min 或 kernel_cpu > sys_display_min 的进程才显示",
    "display_min": 10.0,
    "sys_display_min": 10.0
  },

  "cpu_specs": {
    "_comment": "机器 CPU 规格配置",
    "_description": "用于计算系统负载状态，总容量 = core_count * 100%",
    "core_count": 8,
    "thresholds": {
      "critical_utilization": 0.8,
      "moderate_utilization": 0.5,
      "critical_sys_per_core": 50.0
    }
  },

  "comm_thresholds": {
    "_comment": "进程瓶颈判定阈值配置",
    "_description": "支持全局默认值和 per-comm 定制。判定 BOTTLENECK 条件: (total > sensitive 且 sys_ratio > sys_high) 或 (total >= limit)",
    "global": {
      "sensitive": 100.0,
      "limit": 200.0,
      "sys_high": 50.0,
      "sys_critical": 50.0,
      "total_min": 10.0
    },
    "per_comm": {
      "_comment": "特定进程的配置，未配置的进程使用 global 默认值",
      "kubelet": {
        "sensitive": 80.0,
        "limit": 100.0,
        "sys_high": 30.0
      },
      "telegraf": {
        "sensitive": 80.0,
        "limit": 100.0,
        "sys_high": 50.0
      },
      "containerd": {
        "sensitive": 80.0,
        "limit": 100.0,
        "sys_high": 50.0
      }
    }
  },

  "analysis_thresholds": {
    "_comment": "分析阈值配置 - 所有分析模块使用的阈值",
    "_description": "这些阈值用于控制各种分析算法的敏感度",
    
    "monopoly": {
      "high": 0.8,
      "critical": 0.9
    },
    
    "cv": {
      "unbalanced": 1.0,
      "high": 2.0,
      "affinity_uniform": 0.5,
      "unbalanced_load": 1.5
    },
    
    "cpu_util": {
      "low": 30.0,
      "medium": 50.0,
      "high": 80.0,
      "critical": 100.0
    },
    
    "kernel_ratio": {
      "high": 50.0,
      "critical": 70.0
    },
    
    "core_distribution": {
      "saturated_threshold": 50.0,
      "imbalance_critical": 10.0,
      "imbalance_high": 5.0,
      "imbalance_medium": 2.0
    },
    
    "storm": {
      "spawn_rate": 100.0,
      "severity_high": 50.0,
      "severity_medium": 20.0,
      "severity_low": 10.0
    },
    
    "correlation_flags": {
      "lock_contention_inclusive_pct": 40.0,
      "throttle_victim_cpu_max": 80.0,
      "throttle_rate_min": 50.0
    },
    
    "reliability": {
      "min_duration": 1.0,
      "short_duration": 2.0,
      "medium_duration": 5.0,
      "long_duration": 10.0,
      "low_cpu_threshold": 5.0,
      "medium_cpu_threshold": 10.0,
      "high_cpu_threshold": 30.0
    },
    
    "other": {
      "z_score_medium": 2.0,
      "z_score_high": 2.5,
      "min_sample_count_low": 1000,
      "min_sample_count_medium": 5000,
      "entropy_fixed_threshold": 1.0,
      "entropy_uniform_threshold": 1.8,
      "aggregated_ratio_threshold": 50.0,
      "impact_score_saliency_threshold": 0.5
    }
  }
}
